    <wire from="(820,510)" to="(970,510)" />
    <comp lib="8" loc="(550,190)" name="Text">
      <a name="text" val="AND: all four inputs = 1" />
      <a name="font" val="SansSerif plain 16" />
      <a name="halign" val="left" />
    </comp>
    <comp lib="8" loc="(650,380)" name="Text">
      <a name="text" val="OR: at least one input = 1" />
      <a name="font" val="SansSerif plain 16" />
      <a name="halign" val="left" />
    </comp>
    <comp lib="8" loc="(40,620)" name="Text">
      <a name="text" val="Check: 0000 -&gt; out1=0, out2=0;   1111 -&gt; out1=1, out2=1." />
      <a name="font" val="SansSerif plain 16" />
