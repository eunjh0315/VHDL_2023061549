    <wire from="(580,600)" to="(730,600)" />
    <wire from="(730,600)" to="(730,540)" />
    <wire from="(730,540)" to="(750,540)" />
    <comp lib="0" loc="(970,510)" name="Pin">
      <a name="type" val="output" />
      <a name="facing" val="west" />
      <a name="width" val="1" />
      <a name="label" val="out2" />
