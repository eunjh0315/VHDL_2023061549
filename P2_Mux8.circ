<?xml version='1.0' encoding='utf-8'?>
<project source="5.0.0" version="1.0">
  <lib desc="#Wiring" name="0" />
  <lib desc="#Gates" name="1" />
  <lib desc="#Plexers" name="2" />
  <lib desc="#Arithmetic" name="3" />
  <lib desc="#Memory" name="4" />
  <lib desc="#I/O" name="5" />
  <lib desc="#Base" name="8" />
  <main name="P2_Mux8" />
  <options>
    <a name="simlimit" val="1000" />
  </options>
  <mappings>
    <tool lib="8" name="Poke Tool" map="Button2" />
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool" />
    <tool lib="8" name="Edit Tool" />
    <tool lib="8" name="Wiring Tool" />
    <tool lib="8" name="Text Tool" />
  </toolbar>
  <circuit name="P2_Mux8">
    <a name="appearance" val="logisim_evolution" />
    <comp lib="8" loc="(40,40)" name="Text">
      <a name="text" val="2. 8-to-1 multiplexer" />
      <a name="font" val="SansSerif plain 24" />
      <a name="halign" val="left" />
    </comp>
    <comp lib="8" loc="(40,80)" name="Text">
      <a name="text" val="INPUTS: din[7:0], sel[2:0]                            OUTPUT: data (1 bit)" />
      <a name="font" val="SansSerif plain 16" />
      <a name="halign" val="left" />
    </comp>
    <comp lib="0" loc="(140,320)" name="Pin">
      <a name="type" val="input" />
      <a name="facing" val="east" />
      <a name="width" val="8" />
      <a name="label" val="din" />
      <a name="labelloc" val="north" />
      <a name="labelfont" val="SansSerif bold 18" />
      <a name="radix" val="2" />
      <a name="appearance" val="classic" />
      <a name="initial" val="0xa5" />
      <a name="behavior" val="simple" />
    </comp>
    <wire from="(140,320)" to="(240,320)" />
    <comp lib="0" loc="(240,320)" name="Splitter">
      <a name="facing" val="east" />
      <a name="fanout" val="8" />
      <a name="incoming" val="8" />
      <a name="appear" val="center" />
      <a name="spacing" val="3" />
    </comp>
    <comp lib="2" loc="(560,320)" name="Multiplexer">
      <a name="select" val="3" />
      <a name="width" val="1" />
      <a name="enable" val="false" />
      <a name="size" val="40" />
    </comp>
    <wire from="(260,200)" to="(460,200)" />
    <wire from="(460,200)" to="(460,280)" />
    <wire from="(460,280)" to="(520,280)" />
    <comp lib="8" loc="(280,190)" name="Text">
      <a name="text" val="din[0]" />
      <a name="font" val="SansSerif plain 14" />
      <a name="halign" val="left" />
    </comp>
    <wire from="(260,230)" to="(440,230)" />
    <wire from="(440,230)" to="(440,290)" />
    <wire from="(440,290)" to="(520,290)" />
    <comp lib="8" loc="(280,220)" name="Text">
      <a name="text" val="din[1]" />
      <a name="font" val="SansSerif plain 14" />
      <a name="halign" val="left" />
    </comp>
    <wire from="(260,260)" to="(420,260)" />
    <wire from="(420,260)" to="(420,300)" />
    <wire from="(420,300)" to="(520,300)" />
    <comp lib="8" loc="(280,250)" name="Text">
      <a name="text" val="din[2]" />
      <a name="font" val="SansSerif plain 14" />
      <a name="halign" val="left" />
    </comp>
    <wire from="(260,290)" to="(400,290)" />
    <wire from="(400,290)" to="(400,310)" />
    <wire from="(400,310)" to="(520,310)" />
    <comp lib="8" loc="(280,280)" name="Text">
      <a name="text" val="din[3]" />
      <a name="font" val="SansSerif plain 14" />
      <a name="halign" val="left" />
    </comp>
    <wire from="(260,320)" to="(520,320)" />
    <comp lib="8" loc="(280,310)" name="Text">
      <a name="text" val="din[4]" />
      <a name="font" val="SansSerif plain 14" />
      <a name="halign" val="left" />
    </comp>
    <wire from="(260,350)" to="(400,350)" />
    <wire from="(400,350)" to="(400,330)" />
    <wire from="(400,330)" to="(520,330)" />
    <comp lib="8" loc="(280,340)" name="Text">
      <a name="text" val="din[5]" />
      <a name="font" val="SansSerif plain 14" />
      <a name="halign" val="left" />
    </comp>
    <wire from="(260,380)" to="(420,380)" />
    <wire from="(420,380)" to="(420,340)" />
    <wire from="(420,340)" to="(520,340)" />
    <comp lib="8" loc="(280,370)" name="Text">
      <a name="text" val="din[6]" />
      <a name="font" val="SansSerif plain 14" />
      <a name="halign" val="left" />
    </comp>
    <wire from="(260,410)" to="(440,410)" />
    <wire from="(440,410)" to="(440,350)" />
    <wire from="(440,350)" to="(520,350)" />
    <comp lib="8" loc="(280,400)" name="Text">
      <a name="text" val="din[7]" />
      <a name="font" val="SansSerif plain 14" />
      <a name="halign" val="left" />
    </comp>
    <comp lib="0" loc="(430,520)" name="Pin">
      <a name="type" val="input" />
      <a name="facing" val="east" />
      <a name="width" val="3" />
      <a name="label" val="sel" />
      <a name="labelloc" val="north" />
      <a name="labelfont" val="SansSerif bold 18" />
      <a name="radix" val="2" />
      <a name="appearance" val="classic" />
      <a name="initial" val="0x0" />
      <a name="behavior" val="simple" />
    </comp>
    <wire from="(430,520)" to="(540,520)" />
    <wire from="(540,520)" to="(540,360)" />
    <comp lib="0" loc="(830,320)" name="Pin">
      <a name="type" val="output" />
      <a name="facing" val="west" />
      <a name="width" val="1" />
      <a name="label" val="data" />
      <a name="labelloc" val="north" />
      <a name="labelfont" val="SansSerif bold 18" />
      <a name="radix" val="2" />
      <a name="appearance" val="classic" />
      <a name="initial" val="0x0" />
      <a name="behavior" val="simple" />
    </comp>
    <wire from="(560,320)" to="(830,320)" />
    <comp lib="8" loc="(40,610)" name="Text">
      <a name="text" val="sel=000 selects din[0]; sel=111 selects din[7]. All 2,048 input combinations tested." />
      <a name="font" val="SansSerif plain 16" />
      <a name="halign" val="left" />
    </comp>
  </circuit>
  </project>