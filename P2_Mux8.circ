<?xml version='1.0' encoding='utf-8'?>
<project source="5.0.0" version="1.0">
  <lib desc="#Wiring" name="0" />
  <lib desc="#Gates" name="1" />
  <lib desc="#Plexers" name="2" />
  <lib desc="#Arithmetic" name="3" />
  <lib desc="#Memory" name="4" />
  <lib desc="#I/O" name="5" />
  <lib desc="#Base" name="8" />
  <main name="main" />
  <options>
    <a name="simlimit" val="1000" />
  </options>
  <mappings>
    <tool lib="8" name="Poke Tool" map="Button2" />
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool" />
    <tool lib="8" name="Edit Tool" />
    <tool lib="8" name="Wiring Tool" />
    <tool lib="8" name="Text Tool" />
  </toolbar>
  <vhdl name="p2_mux8_1" appearance="logisim_evolution">-- VHDL_1 homework; adapted from the course examples:
-- https://github.com/lizhuoh9/VHDL_code
-- Active-high display bus: display(7 downto 0) = a b c d e f g dp.
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity p2_mux8_1 is
    port (din : in std_logic_vector(7 downto 0);
          sel : in std_logic_vector(2 downto 0);
          data : out std_logic);
end p2_mux8_1;
architecture bhv of p2_mux8_1 is
begin
    process(din, sel)
    begin
        case sel is
            when "000" =&gt; data &lt;= din(0);
            when "001" =&gt; data &lt;= din(1);
            when "010" =&gt; data &lt;= din(2);
            when "011" =&gt; data &lt;= din(3);
            when "100" =&gt; data &lt;= din(4);
            when "101" =&gt; data &lt;= din(5);
            when "110" =&gt; data &lt;= din(6);
            when "111" =&gt; data &lt;= din(7);
            when others =&gt; data &lt;= '0';
        end case;
    end process;
end architecture;
</vhdl>
  <circuit name="main">
    <a name="appearance" val="logisim_evolution" />
    <comp name="Text" loc="(60,50)" lib="8">
      <a name="text" val="2. 8-to-1 Multiplexer" />
      <a name="font" val="SansSerif plain 24" />
      <a name="halign" val="left" />
    </comp>
    <comp name="p2_mux8_1" loc="(720,260)">
      <a name="facing" val="east" />
      <a name="appearance" val="logisim_evolution" />
    </comp>
    <comp name="Pin" loc="(250,180)" lib="0">
      <a name="type" val="input" />
      <a name="facing" val="east" />
      <a name="width" val="8" />
      <a name="label" val="din" />
      <a name="labelloc" val="north" />
      <a name="labelfont" val="SansSerif bold 18" />
      <a name="radix" val="2" />
      <a name="appearance" val="classic" />
      <a name="initial" val="0xa5" />
      <a name="behavior" val="simple" />
    </comp>
    <wire from="(250,180)" to="(400,180)" />
    <wire from="(400,180)" to="(400,260)" />
    <wire from="(400,260)" to="(500,260)" />
    <comp name="Pin" loc="(250,420)" lib="0">
      <a name="type" val="input" />
      <a name="facing" val="east" />
      <a name="width" val="3" />
      <a name="label" val="sel" />
      <a name="labelloc" val="north" />
      <a name="labelfont" val="SansSerif bold 18" />
      <a name="radix" val="2" />
      <a name="appearance" val="classic" />
      <a name="initial" val="0x0" />
      <a name="behavior" val="simple" />
    </comp>
    <wire from="(250,420)" to="(400,420)" />
    <wire from="(400,420)" to="(400,280)" />
    <wire from="(400,280)" to="(500,280)" />
    <comp name="Pin" loc="(960,260)" lib="0">
      <a name="type" val="output" />
      <a name="facing" val="west" />
      <a name="width" val="1" />
      <a name="label" val="data" />
      <a name="labelloc" val="north" />
      <a name="labelfont" val="SansSerif bold 18" />
      <a name="radix" val="2" />
      <a name="appearance" val="classic" />
      <a name="initial" val="0x0" />
      <a name="behavior" val="simple" />
    </comp>
    <wire from="(720,260)" to="(960,260)" />
    <comp name="Text" loc="(80,540)" lib="8">
      <a name="text" val="sel = 000..111 selects din(0)..din(7)." />
      <a name="font" val="SansSerif plain 18" />
      <a name="halign" val="left" />
    </comp>
  </circuit>
</project>